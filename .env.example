# Copy to .env; shell environment variables take precedence.
# Relative paths resolve from the working directory; use absolute paths for scheduling.
CALLIMACHUS_DESTINATION=local
# Unused when destination=drive: Drive mode keeps no local copy of meeting content.
CALLIMACHUS_ARCHIVE_DIR=./archive
CALLIMACHUS_STATE_DIR=./.callimachus
CALLIMACHUS_POLL_INTERVAL=300
# IANA timezone for "YYYY-MM-DD HH-mm - Title" folder names; changing it renames folders.
CALLIMACHUS_TIMEZONE=UTC
# Makes sync exit 2 while any meeting still waits for its summary or transcript.
CALLIMACHUS_REQUIRE_COMPLETE=false
# Files or folders you delete from the archive stay deleted unless this is true.
CALLIMACHUS_RESTORE_DELETED=false

# Direct Google Drive API: create a Desktop OAuth client in Google Cloud,
# enable Drive API, save JSON here, then run `callimachus login drive`.
CALLIMACHUS_GOOGLE_CLIENT_SECRET_FILE=./credentials/google-client.json
# Blank creates an app-owned Callimachus folder. Existing folders must already
# be accessible to this OAuth app under drive.file; a folder ID alone grants no access.
CALLIMACHUS_GOOGLE_DRIVE_FOLDER_ID=

# Wispr has no API key setting: run `callimachus login wispr` for browser OAuth.
# OAuth callback listener address. Keep 127.0.0.1 on a desktop; the container image sets
# 0.0.0.0 so the published loopback port reaches it. The redirect URI always stays 127.0.0.1.
CALLIMACHUS_OAUTH_BIND=127.0.0.1
# Never commit .env, .callimachus/, credentials/, or real meeting data.

# Docker only: user and group the container runs as (Linux: your `id -u` / `id -g`).
CALLIMACHUS_UID=1000
CALLIMACHUS_GID=1000
