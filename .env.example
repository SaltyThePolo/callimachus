# Callimachus — proposed configuration, not consumed by a runtime yet.
# Copy to .env. Never commit real credentials or meeting content.

# Local directory; may be inside an existing Google Drive desktop folder.
# Use an absolute path outside this repository for personal archives.
CALLIMACHUS_ARCHIVE_DIR=./archive
CALLIMACHUS_TIMEZONE=Europe/Rome
CALLIMACHUS_LOG_LEVEL=info

# Reserved for possible direct Google Drive API support (not implemented).
# This is a folder ID, not a share URL. Authentication is still to be designed.
# CALLIMACHUS_GOOGLE_DRIVE_FOLDER_ID=

# Wispr authentication and connection settings will be documented only after
# supported access to notes, transcripts, and audio has been verified.
